# Supabase (Project Settings → API). Leave empty to run in demo mode with sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for parent-consent links and admin tasks. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL, used in consent links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bunny Stream (protected video). Leave empty to turn video upload off.
BUNNY_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Library → Security → "Token authentication key" (not the API key above)
BUNNY_TOKEN_KEY=
