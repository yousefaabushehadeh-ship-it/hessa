# Supabase (Project Settings → API Keys). Leave empty to run in demo mode with sample data.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_...) or, on older projects, the anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: the secret key (sb_secret_...) or the older service_role key. Used for admin tasks and
# parent report links. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL, used in consent links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# How the login code is sent: whatsapp (default) or sms. Both go through Twilio, set in Supabase
# (Authentication → Sign In / Providers → Phone). See docs/whatsapp-otp.md.
OTP_CHANNEL=whatsapp

# Bunny Stream (protected video). Leave empty to turn video upload off.
BUNNY_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Library → Security → "Token authentication key" (not the API key above)
BUNNY_TOKEN_KEY=
